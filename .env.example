# ==============================================================================
# Institutional Portfolio Risk Dashboard - Environment Configuration Template
# MODULE 01 — FEED REGISTRY & CONFIGURATION
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=dev_secret_key_change_in_production_2026

# Database Connection
# PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/portfolio_risk
# Local zero-dependency dev/test: sqlite+aiosqlite:///./feed_registry.db
DATABASE_URL=sqlite+aiosqlite:///./feed_registry.db
SYNC_DATABASE_URL=sqlite:///./feed_registry.db

# Admin Security & API Auth
ADMIN_API_KEY=admin_dev_secret_key
OPERATOR_API_KEY=operator_dev_secret_key
READONLY_API_KEY=readonly_dev_secret_key

# Secret Reference Provider (Backends: ENV, VAULT, KEYRING)
SECRETS_PROVIDER_BACKEND=ENV

# ------------------------------------------------------------------------------
# Provider Secret Placeholders (Resolved via secret:// URI scheme)
# ------------------------------------------------------------------------------
SECRET_REF_KITE_API_KEY=
SECRET_REF_KITE_ACCESS_TOKEN=
SECRET_REF_NSE_VENDOR_API_KEY=
SECRET_REF_FIX_PASSWORD=

